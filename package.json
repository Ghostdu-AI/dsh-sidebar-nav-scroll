{
  "name": "dsh-sidebar-nav-scroll",
  "version": "1.0.1",
  "type": "module",
  "description": "Caps the sidebar's global panel list at half its natural height, scrolls it, and hands the freed height to the workspace area below.",
  "license": "MIT",
  "author": "fanchuan",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghostdu-AI/dsh-sidebar-nav-scroll.git"
  },
  "bugs": {
    "url": "https://github.com/Ghostdu-AI/dsh-sidebar-nav-scroll/issues"
  },
  "homepage": "https://github.com/Ghostdu-AI/dsh-sidebar-nav-scroll#readme",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/browser.test.cjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
